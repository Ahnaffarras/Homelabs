#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.k3s.local
manage_etc_hosts: true

users:
  - name: ${vm_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: [sudo]
    ssh_authorized_keys:
      - ${ssh_key}

# Nonaktifkan login password, hanya SSH key
ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: false

packages:
%{ for pkg in packages ~}
  - ${pkg}
%{ endfor ~}

runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  - swapoff -a
  - sed -i '/swap/d' /etc/fstab

final_message: "cloud-init selesai setelah $UPTIME detik untuk ${hostname}"
